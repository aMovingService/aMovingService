rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: leads
    // Document ID: generated by a future trusted intake service
    //
    // Each document contains private customer information and is never
    // accessible to a public browser. Required fields:
    //   schemaVersion: int (immutable, must be 1)
    //   source: string (immutable, must be website)
    //   status: string (new/contacted/quoted/booked/closed)
    //   fullName: string (immutable, 1-120 characters)
    //   email: string (immutable, 3-254 characters)
    //   phone: string (immutable, 7-32 characters)
    //   moveDate: timestamp | null (immutable)
    //   moveSize: string (immutable enum)
    //   origin/destination: string (immutable, 1-160 characters)
    //   details: string (immutable, 0-4000 characters)
    //   consentAt/submittedAt: timestamp (immutable)
    //   updatedAt: timestamp (staff server timestamp only)
    //   assignedToUid: string | null (staff workflow assignment)
    //   lastContactedAt: timestamp | null (staff server timestamp only)
    //   internalNote: string (0-4000 characters, staff-only)
    //
    // A future trusted backend will create leads with the Admin SDK. Admin SDK
    // calls bypass these client rules and must validate its own input. There
    // are deliberately no client-created user or staff-role documents.
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Reserved for future user-owned, non-PII collections. It is not used to
    // authorize lead access, which requires the stronger isStaff() check.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // These helpers prevent a future user-owned model from accepting a forged
    // uid. The current strict lead schema intentionally has no uid field.
    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validString(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validEmail(value) {
      return validString(value, 3, 254)
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function validTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    // A Firebase Authentication custom claim, issued by a privileged trusted
    // process, is the sole source of staff authorization. A user cannot grant
    // themselves this claim from the browser or Firestore.
    function isStaff() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.staff == true;
    }

    function allowedLeadFields() {
      return [
        'schemaVersion', 'source', 'status',
        'fullName', 'email', 'phone', 'moveDate', 'moveSize',
        'origin', 'destination', 'details', 'consentAt',
        'submittedAt', 'updatedAt', 'assignedToUid',
        'lastContactedAt', 'internalNote'
      ];
    }

    // Domain validator. This runs on both the disabled client-create branch
    // and every permitted client update, so schema validation cannot be
    // bypassed through an update.
    function isValidLead(data) {
      return hasRequiredFields(data, allowedLeadFields())
        && hasOnlyAllowedFields(data, allowedLeadFields())
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.source == 'website'
        && data.status in ['new', 'contacted', 'quoted', 'booked', 'closed']
        && validString(data.fullName, 1, 120)
        && validEmail(data.email)
        && validString(data.phone, 7, 32)
        && validTimestampOrNull(data.moveDate)
        && data.moveSize in [
          'studio', 'one-bedroom', 'two-bedroom', 'three-bedroom',
          'four-plus', 'commercial', 'unknown'
        ]
        && validString(data.origin, 1, 160)
        && validString(data.destination, 1, 160)
        && validString(data.details, 0, 4000)
        && data.consentAt is timestamp
        && data.submittedAt is timestamp
        && data.updatedAt is timestamp
        && (data.assignedToUid == null
          || validString(data.assignedToUid, 1, 128))
        && validTimestampOrNull(data.lastContactedAt)
        && validString(data.internalNote, 0, 4000);
    }

    function validStatusTransition(before, after) {
      return before == after
        || (before == 'new' && after in ['contacted', 'closed'])
        || (before == 'contacted' && after in ['quoted', 'booked', 'closed'])
        || (before == 'quoted' && after in ['booked', 'closed'])
        || (before == 'booked' && after == 'closed');
    }

    // A staff member can claim an unassigned lead or release their own claim.
    // They cannot overwrite another staff member's assignment.
    function validAssignment(after, before) {
      return after.assignedToUid == before.assignedToUid
        || (
          (before.assignedToUid == null || isOwner(before.assignedToUid))
          && (after.assignedToUid == null || isOwner(after.assignedToUid))
        );
    }

    function validStaffLeadUpdate() {
      return isValidLead(request.resource.data)
        && uidNotModified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedToUid', 'lastContactedAt', 'internalNote',
          'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.lastContactedAt
            == resource.data.lastContactedAt
          || request.resource.data.lastContactedAt == request.time
        )
        && validStatusTransition(
          resource.data.status,
          request.resource.data.status
        )
        && validAssignment(request.resource.data, resource.data);
    }

    // ===============================================================
    // Access Rules
    // ===============================================================

    match /leads/{leadId} {
      // Leads contain PII. Only verified staff with the server-issued claim
      // can read them; ordinary Google-authenticated users cannot.
      allow read: if isStaff();

      // Browsers never create leads. The trusted intake service uses the Admin
      // SDK; this false gate is intentional, while retaining full validation
      // here as a guard against accidentally opening client creation later.
      allow create: if isValidLead(request.resource.data)
        && uidUnchanged()
        && false;

      // Staff can update narrowly defined workflow fields only.
      allow update: if isStaff() && validStaffLeadUpdate();

      // Lead deletion is a privileged retention operation and not a browser
      // capability.
      allow delete: if false;
    }

    // Default deny includes every future collection and subcollection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
